{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "description": "A reference to a row of the referenced entity: its qname (key or code as the source names it) and the surface it was read from.",
      "properties": {
        "display": {
          "type": "string"
        },
        "qname": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "qname"
      ],
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "description": "[start, end) in Unicode code points of the unit's NFC text.",
      "properties": {
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "unitId": {
          "type": "integer"
        }
      },
      "required": [
        "end",
        "start",
        "unitId"
      ],
      "type": "object"
    }
  },
  "$id": "ttr:types/Statement.review",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A product review as the customer wrote it.",
  "properties": {
    "attributes": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string",
          "x-ttr-attribute": "er.entity.review.body"
        },
        "customer": {
          "$ref": "#/$defs/Ref",
          "x-ttr-attribute": "er.entity.review.customer",
          "x-ttr-references": "er.entity.customer"
        },
        "helpful_votes": {
          "type": "integer",
          "x-ttr-attribute": "er.entity.review.helpful_votes"
        },
        "item": {
          "$ref": "#/$defs/Ref",
          "x-ttr-attribute": "er.entity.review.item",
          "x-ttr-references": "er.entity.item"
        },
        "price_paid": {
          "type": "number",
          "x-ttr-attribute": "er.entity.review.price_paid",
          "x-ttr-scale": 2
        },
        "rating": {
          "description": "Stars, 1 to 5.",
          "type": "integer",
          "x-ttr-attribute": "er.entity.review.rating"
        },
        "recommended": {
          "type": "boolean",
          "x-ttr-attribute": "er.entity.review.recommended"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string",
          "x-ttr-attribute": "er.entity.review.recorded_at"
        },
        "reviewed_on": {
          "format": "date",
          "type": "string",
          "x-ttr-attribute": "er.entity.review.reviewed_on"
        },
        "sentiment": {
          "enum": [
            "positive",
            "neutral",
            "negative"
          ],
          "type": "string",
          "x-ttr-attribute": "er.entity.review.sentiment"
        },
        "title": {
          "maxLength": 120,
          "type": "string",
          "x-ttr-attribute": "er.entity.review.title"
        }
      },
      "type": "object"
    },
    "concept": {
      "enum": [
        "cn.NegativeReview",
        "cn.Review",
        "cn.VerifiedReview"
      ],
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "modifiers": {
      "additionalProperties": false,
      "properties": {
        "temporal_context": {
          "enum": [
            "current",
            "past",
            "intended"
          ],
          "type": "string",
          "x-ttr-attribute": "er.entity.review.temporal_context",
          "x-ttr-quality": "cn.temporal_context"
        },
        "verification": {
          "enum": [
            "verified_purchase",
            "unverified",
            "employee"
          ],
          "type": "string",
          "x-ttr-attribute": "er.entity.review.verification",
          "x-ttr-quality": "cn.verification"
        }
      },
      "type": "object"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/Span"
      },
      "minItems": 1,
      "type": "array"
    },
    "verbatim": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "attributes",
    "spans",
    "verbatim"
  ],
  "title": "Statement[review]",
  "type": "object",
  "x-ttr-concept": "cn.Review",
  "x-ttr-entity": "er.entity.review",
  "x-ttr-kind": "statement"
}
