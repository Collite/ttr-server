# Copy to .env (git-ignored) and fill in.

# Superset's own key: `openssl rand -base64 42`.
SUPERSET_SECRET_KEY=

# The realm the Server's edge trusts (its QUERY_FLIGHT_AUTH_ISSUER), at a URL your browser AND the container both
# reach. Keycloak stamps tokens with the URL they were asked for, and the edge refuses another issuer.
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/hartland

# The confidential client Superset signs in with (standard flow). Valid redirect URIs:
#   http://localhost:8088/oauth-authorized/keycloak     (signing in)
#   http://localhost:8088/api/v1/database/oauth2/       (reading a Tatrman database, if this client does both)
# A `groups` mapper on the client puts the user's groups into userinfo; SUPERSET_ADMIN_GROUP's members are Admin.
KEYCLOAK_CLIENT_ID=superset
KEYCLOAK_CLIENT_SECRET=
SUPERSET_ADMIN_GROUP=superset-admins

# The client the engine spec gets each viewer's token from (DATABASE_OAUTH2_CLIENTS["tatrman"]); empty = the
# sign-in client above. If the edge sets QUERY_FLIGHT_AUTH_AUDIENCE, this client's tokens must carry that audience.
TATRMAN_CLIENT_ID=
TATRMAN_CLIENT_SECRET=
