<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- PL-P3.S1.T2: OTEL logback appender dropped on the platform (platform precedent —
         observability is inline micrometer/prometheus; no otel transplant). -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="org.tatrman.charon" level="DEBUG"/>

    <!-- gRPC's shaded Netty is noisy at DEBUG. Pin to INFO. -->
    <logger name="io.grpc.netty.shaded.io.netty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
</configuration>
