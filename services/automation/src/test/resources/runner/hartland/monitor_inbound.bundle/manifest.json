  "recipe": {
    "name": "monitor_inbound",
    "key": [
      "return_request_line.line_id"
    ],
    "asOf": "now",
    "document": "handling-a-return-request.md",
    "parameters": [
      {
        "name": "inbound_reminder",
        "type": "days",
        "value": "14"
      },
      {
        "name": "inbound_close",
        "type": "days",
        "value": "30"
      },
      {
        "name": "settlement",
        "type": "working_days",
        "value": "5"
      }
    ],
    "bindings": [
      {
        "name": "as_of",
        "type": "datetime",
        "source": "run"
      }
    ],
    "roles": {
      "candidates": "awaiting",
      "contexts": [
        {
          "name": "receipts",
          "class": "per-candidate",
          "kind": "sql"
        },
        {
          "name": "age",
          "class": "per-candidate",
          "kind": "canonical"
        },
        {
          "name": "reminded",
          "class": "per-candidate",
          "kind": "sql"
        }
      ],
      "decision": "inbound",
      "routes": [
        {
          "name": "complete",
          "because": "returned in full",
          "detail": [
            "receipts"
          ],
          "turnFed": false
        },
        {
          "name": "damaged",
          "because": "incomplete or damaged return",
          "detail": [
            "receipts"
          ],
          "turnFed": false
        },
        {
          "name": "expired",
          "because": "nothing returned after {inbound_close} days",
          "detail": [],
          "turnFed": false
        },
        {
          "name": "remind",
          "because": "nothing returned after {inbound_reminder} days",
          "detail": [],
          "turnFed": false
        }
      ],
      "switchMode": "exclusive",
      "elseRoute": "none"
    },
    "wiring": [
      {
        "routes": [
          "inbound.complete"
        ],
        "action": "fulfil",
        "columns": {
          "line": "line_id",
          "kind": "inbound",
          "to": "fulfilled"
        }
      },
      {
        "routes": [
          "inbound.complete"
        ],
        "action": "set_state",
        "columns": {
          "line": "line_id",
          "to": "goods_received"
        }
      },
      {
        "routes": [
          "inbound.complete"
        ],
        "action": "expect",
        "columns": {
          "line": "line_id",
          "kind": "credit_note",
          "due": "working_days(:settlement)"
        },
        "when": "way = \"refund_after_return\""
      },
      {
        "routes": [
          "inbound.complete"
        ],
