package hartland.automation
model automation

// ---- programs: mode and port only; no deliver / schedule / event (rule 4) ----
def program morning_release        { recipe: release_order,   port: none, mode: batch,    as_of: run }
def program release_on_placement   { recipe: release_order,   port: key,  mode: on_event, as_of: event }

def program decide_on_request      { recipe: decide_return,   port: key,  mode: on_event, as_of: event }
def program decide_catch_up        { recipe: decide_return,   port: none, mode: batch,    as_of: run }
def program inbound_on_receipt     { recipe: monitor_inbound, port: key,  mode: on_event, as_of: event }
def program inbound_daily          { recipe: monitor_inbound, port: none, mode: batch,    as_of: run }
def program settle_on_document     { recipe: settle,          port: key,  mode: on_event, as_of: event }
def program settle_daily           { recipe: settle,          port: none, mode: batch,    as_of: run }
// removed: def schema line_received / receipt_posted / settlement_posted — the ERP's events are engine messages (D-143)
