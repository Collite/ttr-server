// ===== sales (all channels) — stacked on er.query.sales_union, so it has no er2db: its attributes bind to the
// query's output columns (model/er/sales.ttrm). The db view `db.dbo.channel_sales` the former `channel_sales` read
// stays in `model/db/views.ttrm`, unmapped: the routing corpus's validation SQL reads it (run-set/routing/validation).

// ===== AU (automation agents) — the H-1/H-2 extension + the H-3/H-5 write-back entities =====
// One er2db_entity per entity, one er2db_attribute per attribute — the completeness T6.5 and
// model/tests/automation-extension.test.mjs (c) enforce. Views bind like tables.

// ----- order → the TABLE db.dbo.sales_order (`order` is reserved in SQL, D-119) -----
def er2db_entity order_map { entity: er.entity.order, target: { table: db.dbo.sales_order } }
def er2db_attribute order_order_number_map         { attribute: er.entity.order.order_number,         target: { column: db.dbo.sales_order.so_order_number } }
