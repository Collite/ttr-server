def er2db_attribute order_placed_date_map          { attribute: er.entity.order.placed_date,          target: { column: db.dbo.sales_order.so_placed_date } }
def er2db_attribute order_delivered_date_map       { attribute: er.entity.order.delivered_date,       target: { column: db.dbo.sales_order.so_delivered_date } }
def er2db_attribute order_fulfilling_warehouse_map { attribute: er.entity.order.fulfilling_warehouse, target: { column: db.dbo.sales_order.so_warehouse_sk } }
def er2db_attribute order_value_map                { attribute: er.entity.order.value,                target: { column: db.dbo.sales_order.so_value } }
def er2db_attribute order_state_map                { attribute: er.entity.order.state,                target: { column: db.dbo.sales_order.so_state } }
def er2db_attribute order_held_for_map             { attribute: er.entity.order.held_for,             target: { column: db.dbo.sales_order.so_held_for } }
def er2db_attribute order_placed_by_map            { attribute: er.entity.order.placed_by,            target: { column: db.dbo.sales_order.so_placed_by } }

