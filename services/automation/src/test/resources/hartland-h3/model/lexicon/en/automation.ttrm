package hartland

model lexicon locale en

// AU (automation agents) — the English words of the extension's documents, twin of cs/automation.ttrm. Most
// documents need nothing here: the entity's `displayLabel.en` and `labelPlural` ("Order" / "Orders",
// "Invoice" / "Invoices", "Credit Note" / "Credit Notes", …) are already its singular and plural terms. This
// file adds only the surfaces those two do not spell. The states, ways and conditions are the attributes'
// `valueLabels`.
//
// The ⚑AU-H-3 rule holds in English with nothing declared: "order(s)" and "return request(s)" are the AU
// documents' labels, while the returns facts keep "Store Returns" etc. — longer spans. ("Web Orders" and
// "Marketplace Orders" went with the sales facts' labels at md/hop HP-H: those facts are sources of `sales` only.)
// Nothing here may claim a word the pre-AU vocabulary binds (lexicon/tests/automation-lexicon.test.mjs).

def term sales_line_en {
    description: "sales lines — the order's lines"
    for: er.entity.sales_line
    forms: ["sales line", "sales lines"]
}

def term customer_price_en {
    description: "individual prices — a customer's own price"
    for: er.entity.customer_price
    forms: ["individual price", "individual prices"]
}

def term warehouse_outage_en {
    description: "outages — a distribution center that cannot ship"
    for: er.entity.warehouse_outage
    forms: ["outage", "outages"]
}

def term return_receipt_en {
    description: "receipts — the warehouse receipt of returned goods"
    for: er.entity.return_receipt
    forms: ["receipts"]
}

def term refund_payment_en {
    description: "refunds — the refund paid against a credit note"
    for: er.entity.refund_payment
    forms: ["refunds"]
}

def term winback_mail_en {
    description: "win-back mails — the win-back recipe's mailings"
    for: er.entity.winback_mail
    forms: ["win-back mail", "win-back mails"]
}
