model er

// LQ (contracts L-2, L-4) — logical queries the parse worker refuses, and an entity stacked on a query
// whose body lacks a column the entity binds. Each is a shape `LogicalQueryParseWorkerSpec` pins.

// Mixed lanes: an entity and a table in one body.
def query sale_paid_mixed {
    description: "Reads the sale entity and the store_sales table together",
    sourceText: """sql
SELECT sale.ticket_number, store_sales.ss_net_paid
FROM sale JOIN store_sales ON sale.ticket_number = store_sales.ss_ticket_number
"""
}

// A logical query with a parameter (ruling LQ-5: a parametrized query stays a db query).
def query shopper_revenue_over {
    description: "Shoppers whose revenue is over a threshold",
    sourceText: """sql
SELECT shopper.shopper_id, SUM(sale.revenue) AS revenue
FROM sale JOIN shopper
GROUP BY shopper.shopper_id
HAVING SUM(sale.revenue) > {threshold}
""",
    parameters: [ { name: threshold, type: decimal, label: "Threshold" } ]
}

// An entity stacked on shopper_revenue that binds an attribute to a column the body does not output.
def entity shopper_spend { description: "A shopper with a spend the query does not compute",
    binding: { target: { query: er.query.shopper_revenue } },
    attributes: [
        def attribute shopper_id { type: int, isKey: true, description: "Shopper key" },
        def attribute spend { type: decimal, optional: true, binding: spend_total, description: "Not in the query's output" }
    ]
}

// An entity stacked on a db-lane query (L-4: either lane), one attribute bound to a column it does not output.
def entity ticket_revenue { description: "Net paid per ticket, with a column the query does not compute",
    binding: { target: { query: store_revenue } },
    attributes: [
        def attribute ticket { type: int, isKey: true, binding: ss_ticket_number, description: "Sales ticket" },
        def attribute revenue { type: decimal, optional: true, description: "Net paid" },
        def attribute margin { type: decimal, optional: true, description: "Not in the query's output" }
    ]
}

// A bare JOIN the model cannot condition: no relation joins a sale to a household (only through a shopper). The
// translator keeps the Cartesian product and warns; a saved query stored that way would answer every household with
// every sale, so the worker refuses it.
def query sale_household_unjoined {
    description: "Revenue by buying potential, joined without the shopper between them",
    sourceText: """sql
SELECT household.buy_potential, SUM(sale.revenue) AS revenue
FROM sale JOIN household
GROUP BY household.buy_potential
"""
}
