model db schema dbo

// The db-side twin of mention-er.ttrm. `60-semantics-db.ttrm` (vendored) proves the
// grounding facet attaches to `table`/`column`; nothing anywhere proves the MENTION facet
// does, because that golden predates MS and cannot be edited from this repo. A db table
// carries `mentionSemantics` in the typed model exactly as an entity does, so veles must
// project it the same way — including the aggregation join onto its columns.

def table invoice_line {
    semantics {
        name: label,
        code: line_no,
        measures: [amount, { attribute: qty, aggregation: avg }]
    },
    columns: [
        def column label { type: text },
        def column line_no { type: { type: varchar, length: 12 } },
        def column amount { type: decimal },
        def column qty { type: decimal }
    ]
}
