model er

// MS-P2·S1 — a veles-LOCAL fixture, deliberately not a vendored tatrman golden.
//
// `fixture-semantics/59-semantics.ttrm` is a conformance golden copied verbatim, so it
// cannot be edited from this repo. It covers the mention facet on its own (Customer,
// SalesOrderLine) but leaves one case unreachable: an attribute carrying BOTH facets —
// a grounding `role: amount` AND a place in its owner's `measures:`. That case is the
// whole reason the mention facet is declared entity-side rather than as another `role:`
// (design.md: one column is routinely both an amount to convert and the measure people
// ask for), so veles must prove the two project side by side without interfering.

def entity Invoice {
    semantics {
        name: title,
        code: invoice_no,
        measures: [{ attribute: total_czk, aggregation: sum }, { attribute: line_count, aggregation: count }]
    },
    attributes: [
        def attribute title { type: text },
        def attribute invoice_no { type: { type: varchar, length: 12 } },
        // BOTH facets on one attribute: grounded as a convertible amount, and listed as a
        // measure. `role`, `currency_attribute` and `aggregation` must all arrive together.
        def attribute total_czk { type: decimal, semantics { role: amount, currency: ccy } },
        def attribute ccy { type: { type: varchar, length: 3 }, semantics { role: currency_code } },
        def attribute line_count { type: decimal }
    ]
}
