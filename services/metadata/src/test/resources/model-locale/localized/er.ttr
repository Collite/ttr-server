package localized

// NLS-P10 T6 fixture (grammar 0.13, ⚑GXP-D7) — the four description shapes Veles'
// D7 chain has to tell apart. Kept OUT of the bundled `model-ttr/` production tree
// on purpose: this is a locale matrix, not estate content.
def entity bilingual {
    description: { cs: "Dvojjazyčný popis", en: "A bilingual description" },
    labelPlural: "bilinguals",
    attributes: [
        def attribute id { type: int, isKey: true, description: { cs: "Identifikátor", en: "Identifier" } },
        def attribute plain_attr { type: text, description: "an attribute described the old way" },
        def attribute undescribed { type: text }
    ]
}

// No `cs` entry — a request for cs must fall through to `en`.
def entity english_only {
    description: { en: "English only" },
    attributes: [
        def attribute id { type: int, isKey: true }
    ]
}

// Neither the requested locale nor `en` — the chain ends at "first by language code".
def entity neither {
    description: { de: "Nur Deutsch", fr: "Seulement en français" },
    attributes: [
        def attribute id { type: int, isKey: true }
    ]
}

// An authored-but-EMPTY entry. The chain tests PRESENCE on the map steps, so `cs` wins
// and serves "" rather than promoting the `en` text. Pinned because it is the one input
// where "presence" and "truthiness" diverge, and the LSP reader implements the same chain
// (`model-graph.ts` `resolveDescription`) — the two must not disagree about it.
def entity empty_entry {
    description: { cs: "", en: "Fallback" },
    attributes: [
        def attribute id { type: int, isKey: true }
    ]
}

// The regression pin: a plain-string model must serve exactly what it served at 0.12.
def entity plain {
    description: "a plain description",
    attributes: [
        def attribute id { type: int, isKey: true }
    ]
}
