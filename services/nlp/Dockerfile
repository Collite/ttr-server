# nlp ENGINE-FREE FRONT — multi-stage Dockerfile.
#
# RG-P1: the front is the gRPC contract server (NlpService on :7271) + a REST
# dev/health mirror (:7270). It owns its generated org.tatrman.{nlp,common}.v1
# Python stubs (produced from the shared .proto by scripts/gen_proto.py at build
# — NOT the shared-proto package, which emits messages only and would collide).
#
# ENGINE-FREE (S3.T6): NO torch, NO models, NO per-engine native deps — the
# model-bearing engines are separate backend images (backends/*); the front
# reaches them over HTTP. Only langid (lingua) runs in-process.
#
# Build from the repo root (uv path-deps + the proto tree resolve there):
#   docker build -t nlp:dev -f services/nlp/Dockerfile .

# Base images are ghcr.io/collite copies of the Docker official images (.github/workflows/mirror-base-images.yml).
FROM ghcr.io/collite/python:3.13-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ===== dependencies layer =====
FROM base AS deps

WORKDIR /build/services/nlp
COPY shared/libs/python/otel-config /build/shared/libs/python/otel-config
# NLS-P3.2: the ttr-nlp wheel source, so the image builds with NO PyPI access —
# the rule engine, gazetteers, pack loader and serializer all run in-process in
# this front. The wheel is model-free, so this does not touch the engine-free
# invariant (S3.T6, verified by tests/test_engine_free_front.py).
#
COPY shared/libs/python/ttr-nlp /build/shared/libs/python/ttr-nlp
COPY services/nlp/pyproject.toml services/nlp/uv.lock ./
# ⛑⛑ `--no-dev`, and it is not an optimisation (NLS-P9.3 T7). The dev group
# carries `ttr-morph` as an EDITABLE PATH — deliberately, ⛑LMP-D4: the package is
# never published, and a runtime dependency on it here would make this service
# uninstallable outside the monorepo. But this stage copies only `ttr-nlp`, so
# a plain `uv sync` (which installs the dev group) fails at plan time with
# "Distribution not found at: file:///build/shared/libs/python/ttr-morph", and
# the `nlp` image has been unbuildable since NLS-P8.4 added that entry.
#
# The fix is the honest one rather than copying `ttr-morph` in: a RUNTIME image
# has no business carrying pytest, ruff and a protobuf compiler, and the front
# genuinely does not depend on `ttr-morph` at run time — the exporter's `--morph`
# lane imports it lazily and says so when it is absent. The one dev tool the
# BUILD needs is added to the stage that needs it, below.
RUN pip install --upgrade pip && pip install uv && uv sync --frozen --no-dev

# ===== proto generation layer (org.tatrman.{nlp,common}.v1 stubs) =====
FROM deps AS protogen
ENV PATH="/build/services/nlp/.venv/bin:${PATH}"
# protoc + the grpc_python plugin, for THIS stage only — they do not travel into
# the runtime layer, which copies the `deps` venv rather than this one. Pinned to
# the version in `uv.lock`, so the stubs are generated by the compiler the suite
# resolved and not by whatever PyPI serves today.
RUN uv pip install "grpcio-tools==1.81.1"
# The canonical .proto source + the gen script.
COPY shared/proto/src/main/proto /build/shared/proto/src/main/proto
COPY services/nlp/scripts ./scripts
RUN python scripts/gen_proto.py   # → /build/services/nlp/generated/org/...

# ===== runtime layer (thin app layer; engine-free — no models) =====
FROM base AS runtime

RUN useradd -ms /bin/bash appuser

# ⛑ The queue's spool directory, owned by the user that writes it (NLS-P9.3 T7).
# A `url:` sink spools underneath the POST so a studio that is down never costs
# a miss — and on this image the directory did not exist, so the write failed
# with `PermissionError` and (until the guard in `SpoolSink.drain`) took the
# whole query down with it. Both halves were worth fixing: the answer must not
# depend on the queue, and the queue should work.
RUN mkdir -p /var/lib/nlp/morph-queue && chown -R appuser:appuser /var/lib/nlp

WORKDIR /app

COPY --from=deps /usr/local /usr/local
COPY --from=deps /build/services/nlp/.venv /build/services/nlp/.venv
COPY --from=deps /build/shared /build/shared
COPY --from=protogen /build/services/nlp/generated ./generated

USER appuser
COPY --chown=appuser:appuser services/nlp/pyproject.toml services/nlp/README.md ./
COPY --chown=appuser:appuser services/nlp/src ./src
COPY --chown=appuser:appuser services/nlp/config.yaml ./

ENV PATH="/build/services/nlp/.venv/bin:${PATH}"
# `generated/` carries the proto stubs; `src/` the app.
ENV PYTHONPATH=/app/src:/app/generated
ENV CONFIG_FILE=/app/config.yaml
ENV NLP_SERVICE_OTEL_PROTOCOL=grpc
ENV NLP_SERVICE_HOST=0.0.0.0 \
    NLP_SERVICE_PORT=7270 \
    NLP_SERVICE_GRPC_PORT=7271

EXPOSE 7270 7271

# Health via the REST mirror.
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD curl -fsS http://127.0.0.1:${NLP_SERVICE_PORT:-7270}/healthz || exit 1

# main.py runs BOTH servers on one loop: gRPC (:7271, the contract) + uvicorn
# REST mirror (:7270).
CMD ["python", "src/main.py"]
