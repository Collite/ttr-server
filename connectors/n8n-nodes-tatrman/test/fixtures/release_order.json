{
  "name": "release_order",
  "key": [
    "order.order_number"
  ],
  "asOf": "now",
  "document": "releasing-a-placed-order.md",
  "parameters": [
    {
      "name": "tolerance",
      "type": "decimal",
      "value": "0.01"
    },
    {
      "name": "confirmation_threshold",
      "type": "decimal",
      "value": "50000"
    }
  ],
  "roles": {
    "candidates": "placed_orders",
    "contexts": [
      {
        "name": "shortfall",
        "class": "per-candidate",
        "kind": "sql"
      },
      {
        "name": "price_differences",
        "class": "per-candidate",
        "kind": "sql"
      },
      {
        "name": "overdue",
        "class": "per-candidate",
        "kind": "sql"
      }
    ],
    "decision": "verdict",
    "routes": [
      {
        "name": "hold_sales",
        "because": "stock shortfall or price difference",
        "detail": [
          "shortfall",
          "price_differences"
        ],
        "turnFed": false
      },
      {
        "name": "hold_ar",
        "because": "overdue invoices",
        "detail": [
          "overdue"
        ],
        "turnFed": false
      },
      {
        "name": "release_confirmed",
        "because": "all checks passed; above the confirmation threshold",
        "detail": [],
        "turnFed": false
      },
      {
        "name": "release",
        "because": "all checks passed",
        "detail": [],
        "turnFed": false
      }
    ],
    "switchMode": "overlapping",
    "elseRoute": null
  },
  "wiring": [
    {
      "routes": [
        "verdict.release"
      ],
      "action": "release",
      "columns": {
        "order": "order_number"
      },
      "when": null
    },
    {
      "routes": [
        "verdict.release_confirmed"
      ],
      "action": "ask",
      "columns": {
        "who": "role.sales_manager",
        "about": "order_number",
        "action": "release",
        "due": "2 working_days"
      },
      "when": null
    },
    {
      "routes": [
        "verdict.hold_sales"
      ],
      "action": "hold",
      "columns": {
        "order": "order_number",
        "department": "\"Sales\""
      },
      "when": null
    },
    {
      "routes": [
        "verdict.hold_sales"
      ],
      "action": "notify",
      "columns": {
        "who": "role.sales",
        "detail": "shortfall, price_differences"
      },
      "when": null
    },
    {
      "routes": [
        "verdict.hold_ar"
      ],
      "action": "hold",
      "columns": {
        "order": "order_number",
        "department": "\"AR\""
      },
      "when": null
    },
    {
      "routes": [
        "verdict.hold_ar"
      ],
      "action": "notify",
      "columns": {
        "who": "role.ar",
        "detail": "overdue"
      },
      "when": null
    }
  ],
