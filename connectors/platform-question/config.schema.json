{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatrman.org/schemas/platform-question/0.11.0/config.schema.json",
  "title": "Platform question configuration",
  "description": "Parsed YAML or JSON configuration, not the HTTP request envelope. Model, frame-reference, SQL and placeholder checks also run at execution time.",
  "type": "object",
  "properties": {
    "core": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^.+\\.query\\..+$"
                  }
                },
                "required": [
                  "query"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "sql": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "sql"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "entity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "where": {
                    "type": "string",
                    "minLength": 1
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "entity"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "table": {
                    "type": "string",
                    "minLength": 1
                  },
                  "where": {
                    "type": "string",
                    "minLength": 1
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "table"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "golem": {
                "type": "object",
                "properties": {
                  "agent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "agent",
                  "question"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "golem"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?!tatrman_)[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "row_count"
              },
              "over": {
                "type": "string",
                "minLength": 1
              },
              "distinct": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "over"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "exists"
              },
              "over": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "over"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "aggregate"
              },
              "over": {
                "type": "string",
                "minLength": 1
              },
              "agg": {
                "enum": [
                  "sum",
                  "avg",
                  "min",
                  "max",
                  "count"
                ]
              },
              "column": {
                "type": "string",
                "minLength": 1
              },
              "null_is_zero": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "over",
              "agg",
              "column"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "column"
              },
              "over": {
                "type": "string",
                "minLength": 1
              },
              "column": {
                "type": "string",
                "minLength": 1
              },
              "distinct": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "over",
              "column"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "row"
              },
              "over": {
                "type": "string",
                "minLength": 1
              },
              "prefix": {
                "type": "string",
                "pattern": "^(?!tatrman_)([A-Za-z_][A-Za-z0-9_]*)?$"
              }
            },
            "required": [
              "kind",
              "over"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "table"
              },
              "over": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "over"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "scalar"
              },
              "sql": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "sql"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "verdict"
              },
              "over": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "over"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "core"
  ],
  "additionalProperties": false
}
