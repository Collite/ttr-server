  {
    "op": "ImportRdf",
    "glossary": "northline Concepts",
    "turtle": "@prefix ttr: <https://tatrman.org/ns/ttr#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix dct: <http://purl.org/dc/terms/> .\n@prefix w: <urn:ttr:northline:> .\n\n<https://example.org/northline/Party> a owl:Class, ttr:Kind ;\n    ttr:tier \"core\" ;\n    owl:sameAs w:cn.kind.Party ;\n    ttr:groundsTo w:er.entity.buyer ;\n    ttr:groundingLayer \"er\" ;\n    rdfs:label \"Osoba\"@cs, \"Party\"@en ;\n    rdfs:comment \"A trading party\"@en, \"Obchodní partner\"@cs .\n\nttr:involves_buyer a owl:ObjectProperty ;\n    rdfs:domain w:cn.event.Purchase ;\n    rdfs:range w:cn.role.Customer .\n\nttr:involves_item a owl:ObjectProperty ;\n    rdfs:domain w:cn.event.Purchase ;\n    rdfs:range w:cn.kind.Product .\n\nttr:rel_recommends a owl:ObjectProperty ;\n    rdfs:label \"doporučuje\"@cs, \"recommends\"@en .\n\n<urn:ttr:northline> a owl:Ontology ;\n    dct:identifier \"fixture-1\" ;\n    owl:versionInfo \"0.18\" .\n\nw:area.retail a ttr:Area ;\n    ttr:member w:er.entity.buyer, w:pkg.cn, w:pkg.er, w:pkg.md .\n\nw:cn.event.Purchase a owl:Class, ttr:Event ;\n    ttr:tier \"core\" ;\n    ttr:involves [ a ttr:Participation ; ttr:label \"buyer\" ; ttr:concept w:cn.role.Customer ], [ a ttr:Participation ; ttr:label \"item\" ; ttr:concept w:cn.kind.Product ] ;\n    ttr:extent \"instantaneous\" ;\n    ttr:periodAt \"sold_at\" ;\n    ttr:groundsTo w:er.entity.sale ;\n    ttr:groundingLayer \"er\" ;\n    rdfs:label \"Purchase\"@en .\n\nw:cn.kind.Product a owl:Class, ttr:Kind ;\n    ttr:tier \"core\" ;\n    ttr:groundsTo w:er.entity.product ;\n    ttr:groundingLayer \"er\" ;\n    rdfs:label \"Product\"@en .\n\nw:cn.kind.Prospect a owl:Class, ttr:Kind ;\n    ttr:tier \"open\" ;\n    ttr:abstract true ;\n    ttr:is_a <https://example.org/northline/Party> ;\n    rdfs:subClassOf <https://example.org/northline/Party> ;\n    rdfs:label \"Prospect\"@en .\n\nw:cn.phase.LargePurchase a owl:Class, ttr:Phase ;\n    ttr:tier \"core\" ;\n    ttr:definition \"amount > 100\" ;\n    ttr:definitionLanguage \"ttr-pl\" ;\n    rdfs:label \"LargePurchase\"@en .\n\nw:cn.quality.sold_at a owl:Class, ttr:Quality ;\n    ttr:tier \"core\" ;\n    ttr:groundsTo w:er.entity.sale.sold_at ;\n    ttr:groundingLayer \"er\" ;\n    rdfs:label \"sold_at\"@en .\n\nw:cn.relation_type.recommends a owl:Class, ttr:RelationType ;\n    ttr:tier \"open\" ;\n    rdfs:label \"doporučuje\"@cs, \"recommends\"@en .\n\nw:cn.role.Customer a owl:Class, ttr:Role ;\n    ttr:tier \"core\" ;\n    ttr:groundsTo w:md.dimension.Buyer ;\n    ttr:groundingLayer \"md\" ;\n    rdfs:label \"Customer\"@en .\n"
  },
