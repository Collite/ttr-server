# Helm: vendored library/subchart deps are rebuilt by scripts/helm-deps.sh
# (per-service charts + the SV-P4 umbrella). The golden/ output IS committed.
**/k8s/charts/
**/k8s/Chart.lock
helm/tatrman-server/charts/
helm/tatrman-server/Chart.lock

# RG-P1.S1 — nlp Python proto stubs (regenerated from shared/proto via
# services/nlp/scripts/gen_proto.py; canonical source is the .proto file).
services/nlp/generated/

# RV-P4.1 — golem-py Python proto stubs (same posture, same canonical source:
# services/golem-py/scripts/gen_proto.py).
services/golem-py/generated/

# NLS-P3.1 — the ttr-nlp wheel's own nlp.v1 stubs. The wheel ships the client
# (NL-16) and the Document<->proto serializer, and cannot borrow services/nlp's
# copy: consumers install `ttr-nlp` without the service (nlp-mcp, the DFP
# model-validator). Regenerated from shared/proto via that wheel's
# scripts/gen_proto.py; NOT part of the published wheel.
shared/libs/python/ttr-nlp/generated/

# uv's per-module virtualenvs. Every Python module here is deps-only (`package =
# false`), so `.venv/` is pure build output — it was simply never ignored, because
# nothing had run `uv sync` in a tracked checkout before.
**/.venv/

# XM local conformance evidence (uploaded by CI).
conformance/openmetadata/results/
